// A SHADER layer's effect (Enum_ShaderEffect), and the depth fog, on JmeBatch's quads: core's GdxLayerEffects, in jME. JmeLayerEffects sets
// the parameters from GdxLayerEffects.uniforms. Blending, culling and depth are set as JmeBatch sets its own materials'.
MaterialDef ParallaxEffect {

    MaterialParameters {
        Texture2D ColorMap
        // The region's u, v, u2, v2 (v at the image's top).
        Vector4 Region
        // The drawn image's width and height in world units.
        Vector2 Size
        // Amplitude, wavelength, phase.
        Vector3 Effect
        // FOG; WAVE when false.
        Boolean Fog
        // No effect: a layer drawn through the depth fog, or a dissolve's mask, only.
        Boolean Plain
        // The depth fog at the layer, 0 to 1: the color mixed toward FogColor.
        Float Haze : 0.0
        // The page's fog colour.
        Vector3 FogColor : 0.93 0.95 0.97
        // A transfert's dissolve: side (0 none, 1 outgoing, 2 incoming), ramp, softness, drift.
        Vector4 Dissolve : 0.0 0.0 0.0 0.0
        // The dissolve's noise cells across and up the view.
        Vector2 Cells : 0.0 0.0
    }

    Technique {
        VertexShader   GLSL310 GLSL300 GLSL150 GLSL100 : jks/tools2d/parallax/jme/ParallaxEffect.vert
        FragmentShader GLSL310 GLSL300 GLSL150 GLSL100 : jks/tools2d/parallax/jme/ParallaxEffect.frag

        WorldParameters {
            WorldViewProjectionMatrix
        }

        Defines {
            FOG : Fog
            PLAIN : Plain
        }
    }
}
