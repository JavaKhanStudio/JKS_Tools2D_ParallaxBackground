// A SHADER layer's effect (Enum_ShaderEffect), and the depth fog, on JmeBatch's quads: core's GdxLayerEffects, in jME. JmeLayerEffects sets
// the parameters from GdxLayerEffects.uniforms. Blending, culling and depth are set as JmeBatch sets its own materials'.
MaterialDef ParallaxEffect {

    MaterialParameters {
        Texture2D ColorMap
        // The region's u, v, u2, v2 (v at the image's top).
        Vector4 Region
        // The drawn image's width and height in world units.
        Vector2 Size
        // Amplitude, wavelength, phase.
        Vector3 Effect
        // FOG; WAVE when false, and Swell false.
        Boolean Fog
        // SWELL (r431).
        Boolean Swell
        // MIRROR (r455): SWELL, the water a mirror of the page's sky.
        Boolean Mirror
        // No effect: a layer drawn through the depth fog, a dissolve's mask or a grade only.
        Boolean Plain
        // The depth fog at the layer, 0 to 1: the color mixed toward FogColor.
        Float Haze : 0.0
        // The page's fog colour.
        Vector3 FogColor : 0.93 0.95 0.97
        // A transfert's dissolve: side (0 none, 1 outgoing, 2 incoming), ramp, softness, drift.
        Vector4 Dissolve : 0.0 0.0 0.0 0.0
        // The dissolve's noise cells across and up the view.
        Vector2 Cells : 0.0 0.0
        // A transfert through a colour: the colour, and how much the layer is mixed toward it after the fog.
        Vector4 Grade : 0.0 0.0 0.0 0.0
        // FOG across the layer: the view's width in world units, where the noise starts from its left, 1 or -1 (flipped).
        Vector3 Across : 0.0 0.0 1.0
        // The same up the layer: the view's height, where the noise starts from its bottom, 1 or -1 (flipped on Y).
        Vector3 Up : 0.0 0.0 1.0
        // The glint (GdxLayerEffects.glintUniforms): strength (0: none), density, pulses, crest reach; the sun's column;
        // the waves' whole turns across and up; the third's, then the effect's periods.
        Vector4 Glint : 0.0 0.0 0.0 0.0
        Vector2 Sun : 0.5 0.3
        Vector4 GlintA : 0.0 0.0 0.0 0.0
        Vector4 GlintB : 0.0 0.0 1.0 1.0
        // SWELL: 1 on an axis the page repeats on (wrapped), 0 on one it does not (its edge rows held), r434.
        Vector2 Wrap : 1.0 0.0
        // MIRROR (GdxLayerEffects.mirrorUniforms): strength, relief, shine, tint; the horizon's height in local() and the
        // depth; the page's sky at the horizon and over the view.
        Vector4 MirrorNumbers : 0.0 0.0 0.0 0.0
        Vector2 MirrorAt : 1.0 1.0
        Vector3 Sky : 1.0 1.0 1.0
        Vector3 Zenith : 1.0 1.0 1.0
    }

    Technique {
        VertexShader   GLSL310 GLSL300 GLSL150 GLSL100 : jks/tools2d/parallax/jme/ParallaxEffect.vert
        FragmentShader GLSL310 GLSL300 GLSL150 GLSL100 : jks/tools2d/parallax/jme/ParallaxEffect.frag

        WorldParameters {
            WorldViewProjectionMatrix
        }

        Defines {
            FOG : Fog
            SWELL : Swell
            MIRROR : Mirror
            PLAIN : Plain
        }
    }
}
