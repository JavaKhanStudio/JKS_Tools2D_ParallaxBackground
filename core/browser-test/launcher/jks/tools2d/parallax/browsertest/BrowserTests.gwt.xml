<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.11.0//EN" "https://www.gwtproject.org/doctype/2.11.0/gwt-module.dtd">
<!-- Not shipped. The browser suite (browser-test/cases, this package) as a libGDX browser app: core/build.gradle browserTestWar. -->
<module rename-to="browsertests">
	<inherits name="com.badlogic.gdx.backends.gdx_backends_gwt" />
	<inherits name="jks.tools2d.parallax.Parallax" />

	<source path="" />
	<entry-point class="jks.tools2d.parallax.browsertest.BrowserTestLauncher" />

	<!-- Relative to core/, where the compiler runs: the fixtures JvmFixtures writes, copied by the asset preloader. -->
	<set-configuration-property name="gdx.assetpath" value="build/browserTest/assets" />
	<set-configuration-property name="gdx.assetoutputpath" value="build/browserTest/war/" />
	<set-configuration-property name="xsiframe.failIfScriptTag" value="FALSE" />
	<!-- One permutation: "safari" is the WebKit/Blink one, Chrome's. -->
	<set-property name="user.agent" value="safari" />
</module>
