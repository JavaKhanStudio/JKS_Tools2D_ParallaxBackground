<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC "-//Google Inc.//DTD Google Web Toolkit 2.11.0//EN" "https://www.gwtproject.org/doctype/2.11.0/gwt-module.dtd">
<!-- Not shipped. What :core:gwtCheck compiles to JavaScript to prove the library translates as a game inherits it. -->
<module rename-to="gwtcheck">
	<inherits name="com.badlogic.gdx.backends.gdx_backends_gwt" />
	<inherits name="jks.tools2d.parallax.Parallax" />

	<source path="" />
	<entry-point class="jks.tools2d.parallax.gwtcheck.ParallaxGwtCheck" />

	<!-- One permutation is enough to find untranslatable code. -->
	<set-property name="user.agent" value="safari" />
</module>
