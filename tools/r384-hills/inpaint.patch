diff --git a/tools/r239-ai-strips/hills_paint_test.py b/tools/r239-ai-strips/hills_paint_test.py
new file mode 100644
index 0000000..25b1b19
--- /dev/null
+++ b/tools/r239-ai-strips/hills_paint_test.py
@@ -0,0 +1,62 @@
+"""How ai_page.py paints each depth (r384): the hills of the default SD 1.5, with no --denoise, inpainted inside
+sil.py's shape at 1.0 by dreamshaper_8Inpainting (HILLS_INPAINT, Simon's pick in hills-lab); every other depth, model
+and --denoise img2img as before. No GPU: ai_page.py --dry-run's commands.
+
+    python3 tools/r239-ai-strips/hills_paint_test.py
+"""
+import os
+import shlex
+import subprocess
+import sys
+import tempfile
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import ai_page  # noqa: E402
+
+
+def commands(*args):
+    """Each strip's gen.py command (its words split), back to front, of a dry run with args."""
+    with tempfile.TemporaryDirectory() as d:
+        out = subprocess.run([sys.executable, os.path.join(HERE, "ai_page.py"), "--theme", "misty pine forest",
+                              "--layers", "4", *args, "--dry-run", d], capture_output=True, text=True, check=True)
+    return [shlex.split(line.split(" > ")[0]) for line in out.stdout.splitlines() if "/gen.py " in line]
+
+
+def strip(cmd):
+    return os.path.basename(cmd[cmd.index("--out") + 1])
+
+
+def mode(cmd):
+    return cmd[2]
+
+
+class HillsPaintTest(unittest.TestCase):
+
+    def test_default_hills_are_inpainted_inside_the_shape_at_full_strength(self):
+        cmds = {strip(c): c for c in commands()}
+        hills = cmds["l2_ai.png"]  # 4 layers: mountains, mountains, hills, pines
+        self.assertEqual(mode(hills), "inpaint")
+        self.assertEqual(hills[hills.index("--ckpt") + 1], ai_page.HILLS_INPAINT["ckpt"])
+        self.assertEqual(float(hills[hills.index("--denoise") + 1]), 1.0)
+        self.assertEqual(hills.count("--denoise"), 1)
+        self.assertNotIn("--init", hills)
+        self.assertIn("--src", hills)
+        self.assertTrue(hills[hills.index("--src") + 1].endswith("l2_init.png"))
+        self.assertTrue(hills[hills.index("--mask") + 1].endswith("l2_mask.png"))
+        self.assertIn("small round trees", hills[hills.index("--prompt") + 1])
+        self.assertIn("conifers", hills[hills.index("--negative") + 1])
+        for k in ("l0_ai.png", "l1_ai.png", "l3_ai.png"):
+            self.assertEqual(mode(cmds[k]), "img2img", k)
+            self.assertNotIn("--ckpt", cmds[k])
+
+    def test_another_model_or_a_denoise_keeps_img2img(self):
+        for args in (["--denoise", "0.7"], ["--ckpt", "openjourney-v4.ckpt"], ["--style", "pixel"]):
+            for c in commands(*args):
+                if strip(c).startswith("l"):
+                    self.assertNotEqual(mode(c), "inpaint", (args, strip(c)))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/r384-hills/mutate.sh b/tools/r384-hills/mutate.sh
new file mode 100755
index 0000000..35c46e5
--- /dev/null
+++ b/tools/r384-hills/mutate.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+# headless: unit tests, no window
+# mutate.sh — r384's proof: each part of the hills' inpaint recipe in ai_page.py broken in turn, hills_paint_test.py
+# must fail on an assertion (a FAIL, not an import error: a mutant that breaks the import passes nothing).
+# Copies tools/*.py and tools/r239-ai-strips into a scratch folder; the clean copy must pass first. Exits 1 when one
+# survives.
+set -u
+cd "$(dirname "$0")/../.." || exit 1
+WORK=$(mktemp -d)
+trap 'rm -rf "$WORK"' EXIT
+cp tools/*.py "$WORK/"
+cp -r tools/r239-ai-strips "$WORK/"
+T="$WORK/r239-ai-strips/hills_paint_test.py"
+python3 "$T" >"$WORK/clean.log" 2>&1 || { echo "the clean copy fails: $WORK/clean.log"; cat "$WORK/clean.log"; exit 2; }
+survived=0
+mutate() {  # name, the line as it is, the line broken
+	cp tools/r239-ai-strips/ai_page.py "$WORK/r239-ai-strips/ai_page.py"
+	python3 - "$WORK/r239-ai-strips/ai_page.py" "$2" "$3" <<'PY' || { echo "$1: the line is gone, update mutate.sh"; exit 2; }
+import sys
+p, old, new = sys.argv[1:]
+s = open(p).read()
+if s.count(old) != 1:
+    sys.exit(1)
+open(p, "w").write(s.replace(old, new))
+PY
+	python3 "$T" >"$WORK/$1.log" 2>&1
+	if ! grep -q '^FAIL:' "$WORK/$1.log"; then
+		echo "SURVIVED  $1"; tail -5 "$WORK/$1.log"
+		survived=1
+	else
+		echo "killed    $1 ($(grep -c '^FAIL:' "$WORK/$1.log") failing)"
+	fi
+}
+mutate no-inpaint 'return kind == "hills" and not self.pixel' 'return False and not self.pixel'
+mutate any-denoise ' and self.a.denoise is None' ''
+mutate any-ckpt 'self.model["ckpt"] == GEN_CKPT and ' ''
+mutate init-not-src 'if gen[2] == "inpaint":
+            return ["--src"' 'if False:
+            return ["--src"'
+mutate old-words '"words": "rolling hills with small round trees, folds and shadows"' '"words": "rolling hills with small trees"'
+exit $survived
